# ==========================================
# TravelPlanner — Пример конфигурации (.env)
# ==========================================

# --- Настройки базы данных PostgreSQL (для Docker Compose и Prisma) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=travelplanner
POSTGRES_PORT=5432

# Строка подключения Prisma к PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelplanner?schema=public"

# --- Настройки Backend сервера ---
PORT=3000
NODE_ENV=development

# Секретный ключ для подписи сессионных JWT-токенов (замените на случайную строку минимум из 32 символов)
JWT_SECRET="replace-with-a-very-strong-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Доверенный источник для CORS (адрес фронтенда)
FRONTEND_URL="http://localhost:5173"

# Автоматический запуск встроенного локального PostgreSQL-сервера (PGlite Socket),
# если внешний PostgreSQL или Docker недоступен на порту 5432 (true / false)
USE_EMBEDDED_PG_FALLBACK=true

# --- Внешние фотосервисы для фотографий стран (опционально, хранятся только на сервере) ---
# Если ключи не указаны или сервис недоступен, автоматически используется резервный набор фотографий высокого разрешения
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# --- Настройки Frontend (Vite) ---
VITE_API_URL="http://localhost:3000/api"
