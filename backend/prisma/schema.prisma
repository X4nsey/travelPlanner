generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  RUB
  USD
  EUR
}

enum ExpenseCategory {
  TRANSPORT
  FOOD
  LODGING
  ENTERTAINMENT
  SHOPPING
  OTHER
}

enum TripType {
  BEACH
  SIGHTSEEING
  MOUNTAIN
  BUSINESS
  WINTER_SPORT
  WELLNESS_SPA
  MIXED
}

enum PackingCategory {
  DOCUMENTS
  CLOTHING
  FOOTWEAR
  TECH
  HYGIENE
  PERSONAL
  MEDICINE
  ACTIVITY
  OTHER
}

enum PackingItemSource {
  GENERATED
  CUSTOM
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips             Trip[]
  favoriteCountries FavoriteCountry[]

  @@index([email])
}

model FavoriteCountry {
  id          String   @id @default(uuid())
  userId      String
  countrySlug String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, countrySlug])
  @@index([userId])
  @@index([countrySlug])
}

model Trip {
  id             String           @id @default(uuid())
  userId         String
  title          String
  country        String
  city           String
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  travelersCount Int              @default(1)
  budget         Decimal          @default(0) @db.Decimal(12, 2)
  currency       Currency         @default(RUB)
  tripType       TripType?
  description    String           @default("")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         ItineraryEvent[]
  expenses       TripExpense[]
  packingList    PackingList?

  @@index([userId])
  @@index([userId, startDate])
}

model ItineraryEvent {
  id            String   @id @default(uuid())
  tripId        String
  date          DateTime @db.Date
  title         String
  description   String   @default("")
  startTime     String?
  endTime       String?
  location      String?
  estimatedCost Decimal? @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, date, startTime])
}

model TripExpense {
  id          String          @id @default(uuid())
  tripId      String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  currency    Currency        @default(RUB)
  expenseDate DateTime        @db.Date
  description String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, expenseDate])
  @@index([tripId, category])
}

model PhotoRecord {
  id                 String   @id @default(uuid())
  countrySlug        String
  targetType         String
  targetKey          String
  objectName         String
  countryName        String
  cityName           String?
  entityType         String   @default("landmark")
  url                String
  thumbUrl           String
  authorName         String   @default("Wikimedia Commons")
  authorUrl          String   @default("")
  sourceName         String   @default("Wikimedia Commons")
  sourceUrl          String   @default("")
  license            String   @default("CC BY-SA")
  verified           Boolean  @default(false)
  manualOverride     Boolean  @default(false)
  verificationStatus String   @default("verified")
  verificationNotes  String   @default("")
  lastCheckedAt      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([countrySlug, targetType, targetKey])
  @@index([countrySlug])
  @@index([verificationStatus])
  @@index([manualOverride])
}

model PackingList {
  id              String        @id @default(uuid())
  tripId          String        @unique
  lastGeneratedAt DateTime?
  contextSnapshot Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trip            Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items           PackingItem[]
}

model PackingItem {
  id             String            @id @default(uuid())
  packingListId  String
  category       PackingCategory
  name           String
  quantity       Int?
  isPacked       Boolean           @default(false)
  source         PackingItemSource @default(GENERATED)
  ruleKey        String?
  reason         String?
  isEditedByUser Boolean           @default(false)
  isOutdated     Boolean           @default(false)
  isDismissed    Boolean           @default(false)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  packingList    PackingList       @relation(fields: [packingListId], references: [id], onDelete: Cascade)

  @@unique([packingListId, ruleKey])
  @@index([packingListId, category])
  @@index([packingListId, isDismissed])
}


